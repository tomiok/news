        {{ block "css" .}}

        {{ end }}
    </head>
    <body>
    {{ block "content" . }}

    {{ end }}
    <button class="back-to-top" aria-label="Back to top">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M12 4l-8 8h6v8h4v-8h6z"/>
        </svg>
    </button>
    <script src="https://unpkg.com/htmx.org@1.9.2"
            integrity="sha384-L6OqL9pRWyyFU3+/bjdSri+iIphTN/bvYyM37tICVyOJkWZLpP2vGn6VUEXgzg6h" crossorigin="anonymous">
    </script>
    <script>
        // Function to initialize back to top button
        function initBackToTop() {
            const backToTopButton = document.querySelector('.back-to-top');
            if (!backToTopButton) return;

            // Show button when scrolling down
            function handleScroll() {
                if (window.scrollY > 300) {
                    backToTopButton.classList.add('visible');
                } else {
                    backToTopButton.classList.remove('visible');
                }
            }

            // Smooth scroll to top when clicked
            function scrollToTop() {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            }

            // Add event listeners
            window.addEventListener('scroll', handleScroll);
            backToTopButton.addEventListener('click', scrollToTop);
        }

        // Initialize on first load
        initBackToTop();


    </script>
    {{ block "js" .}}
    {{ end }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const backToTopButton = document.querySelector('.back-to-top');

            // Show button when scrolling down
            window.addEventListener('scroll', function() {
                if (window.scrollY > 300) {
                    backToTopButton.classList.add('visible');
                } else {
                    backToTopButton.classList.remove('visible');
                }
            });

            // Smooth scroll to top when clicked
            backToTopButton.addEventListener('click', function() {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });

            // Check if mobile
            let isMobile = window.innerWidth <= 768;

            // Get elements
            const hamburgerButton = document.getElementById('hamburger-button');
            const menuItems = document.getElementById('menu-items');
            const addSourceBtn = document.getElementById('add-source-btn');
            const sourceModal = document.getElementById('source-modal');
            const closeModal = document.querySelector('.close-modal');
            const successMessage = document.getElementById('success-message');

            // Toggle hamburger menu
            hamburgerButton.addEventListener('click', function() {
                hamburgerButton.classList.toggle('active');
                menuItems.classList.toggle('show');
            });

            // Close menu when clicking outside
            document.addEventListener('click', function(event) {
                if (!hamburgerButton.contains(event.target) && !menuItems.contains(event.target)) {
                    hamburgerButton.classList.remove('active');
                    menuItems.classList.remove('show');
                }
            });

            // Open source modal
            addSourceBtn.addEventListener('click', function(event) {
                event.preventDefault();
                sourceModal.classList.add('show');
                // Close the hamburger menu when opening modal
                hamburgerButton.classList.remove('active');
                menuItems.classList.remove('show');

                // Hide success message when opening modal
                if (successMessage) {
                    successMessage.style.display = 'none';
                }
            });

            // Close modal
            closeModal.addEventListener('click', function() {
                sourceModal.classList.remove('show');
            });

            // Close modal when clicking outside
            window.addEventListener('click', function(event) {
                if (event.target === sourceModal) {
                    sourceModal.classList.remove('show');
                }
            });

            // Handle window resize for responsiveness
            window.addEventListener('resize', function() {
                // Update mobile status on resize
                isMobile = window.innerWidth <= 768;
            });

            // Add touch event handlers for mobile
            if ('ontouchstart' in window) {
                addSourceBtn.addEventListener('touchstart', function(event) {
                    event.preventDefault();
                    sourceModal.classList.add('show');
                    hamburgerButton.classList.remove('active');
                    menuItems.classList.remove('show');

                    // Hide success message when opening modal
                    if (successMessage) {
                        successMessage.style.display = 'none';
                    }
                });

                closeModal.addEventListener('touchstart', function() {
                    sourceModal.classList.remove('show');
                });
            }

            const sourceForm = document.getElementById('source-form');
            const spinner = document.getElementById('spinner');

            if (sourceForm) {
                sourceForm.addEventListener('submit', function(event) {
                    event.preventDefault();

                    // Show spinner
                    spinner.style.display = 'inline-block';

                    // Hide any previous success message
                    if (successMessage) {
                        successMessage.style.display = 'none';
                    }

                    // Get form data
                    const sourceUrl = document.getElementById('sourceUrl').value;

                    const jsonData = {
                        sourceUrl: sourceUrl
                    };
                    // Create fetch request
                    fetch('/sources', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(jsonData)
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Network response was not ok');
                            }

                            // Reset the form
                            sourceForm.reset();

                            // Show success message
                            if (successMessage) {
                                successMessage.style.display = 'block';
                            }

                            // Automatically close modal after 2 seconds
                            setTimeout(function() {
                                sourceModal.classList.remove('show');
                            }, 2000);
                        })
                        .catch(error => {
                            // Handle error
                            console.error('Error:', error);

                            // Show error message if needed
                            // You could add an error element in your HTML and display it here
                        })
                        .finally(() => {
                            // Hide spinner regardless of outcome
                            spinner.style.display = 'none';
                        });
                });
            }
        });
    </script>
    </body>
    </html>
{{ end }}