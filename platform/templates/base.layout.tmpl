    </head>
    <body>
    {{ block "content" . }}

    {{ end }}
    <button class="back-to-top" aria-label="Back to top">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M12 4l-8 8h6v8h4v-8h6z"/>
        </svg>
    </button>
    <script src="https://unpkg.com/htmx.org@1.9.2"
            integrity="sha384-L6OqL9pRWyyFU3+/bjdSri+iIphTN/bvYyM37tICVyOJkWZLpP2vGn6VUEXgzg6h" crossorigin="anonymous">
    </script>
    <script>
        // Function to initialize back to top button
        function initBackToTop() {
            const backToTopButton = document.querySelector('.back-to-top');
            if (!backToTopButton) return;

            // Show button when scrolling down
            function handleScroll() {
                if (window.scrollY > 300) {
                    backToTopButton.classList.add('visible');
                } else {
                    backToTopButton.classList.remove('visible');
                }
            }

            // Smooth scroll to top when clicked
            function scrollToTop() {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            }

            // Add event listeners
            window.addEventListener('scroll', handleScroll);
            backToTopButton.addEventListener('click', scrollToTop);
        }

        // Initialize on first load
        initBackToTop();

        // Initialize when HTMX swaps content
        document.body.addEventListener('htmx:afterSwap', function(evt) {
            initBackToTop();
        });
    </script>
    {{ block "js" .}}
    {{ end }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const backToTopButton = document.querySelector('.back-to-top');

            // Show button when scrolling down
            window.addEventListener('scroll', function() {
                if (window.scrollY > 300) {
                    backToTopButton.classList.add('visible');
                } else {
                    backToTopButton.classList.remove('visible');
                }
            });

            // Smooth scroll to top when clicked
            backToTopButton.addEventListener('click', function() {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });

            // Check if mobile
            let isMobile = window.innerWidth <= 768;

            // Get elements
            const hamburgerButton = document.getElementById('hamburger-button');
            const menuItems = document.getElementById('menu-items');
            const addSourceBtn = document.getElementById('add-source-btn');
            const sourceModal = document.getElementById('source-modal');
            const closeModal = document.querySelector('.close-modal');

            // Toggle hamburger menu
            hamburgerButton.addEventListener('click', function() {
                hamburgerButton.classList.toggle('active');
                menuItems.classList.toggle('show');
            });

            // Close menu when clicking outside
            document.addEventListener('click', function(event) {
                if (!hamburgerButton.contains(event.target) && !menuItems.contains(event.target)) {
                    hamburgerButton.classList.remove('active');
                    menuItems.classList.remove('show');
                }
            });

            // Open source modal
            addSourceBtn.addEventListener('click', function(event) {
                event.preventDefault();
                sourceModal.classList.add('show');
                // Close the hamburger menu when opening modal
                hamburgerButton.classList.remove('active');
                menuItems.classList.remove('show');
            });

            // Close modal
            closeModal.addEventListener('click', function() {
                sourceModal.classList.remove('show');
            });

            // Close modal when clicking outside
            window.addEventListener('click', function(event) {
                if (event.target === sourceModal) {
                    sourceModal.classList.remove('show');
                }
            });

            // Handle window resize for responsiveness
            window.addEventListener('resize', function() {
                // Update mobile status on resize
                isMobile = window.innerWidth <= 768;
            });

            // Add touch event handlers for mobile
            if ('ontouchstart' in window) {
                addSourceBtn.addEventListener('touchstart', function(event) {
                    event.preventDefault();
                    sourceModal.classList.add('show');
                    hamburgerButton.classList.remove('active');
                    menuItems.classList.remove('show');
                });

                closeModal.addEventListener('touchstart', function() {
                    sourceModal.classList.remove('show');
                });
            }

            // Handle HTMX responses
            htmx.on('htmx:beforeSwap', function(evt) {
                // Get the response text
                const responseText = evt.detail.xhr.responseText;

                // This will prevent the default swap from happening
                evt.detail.shouldSwap = false;

                // Check if response indicates success
                if (evt.detail.xhr.status >= 200 && evt.detail.xhr.status < 300) {
                    // Success - display quick message and close modal
                    const form = evt.detail.target;

                    // Reset form
                    form.reset();

                    // Create a success notification
                    const successMessage = document.createElement('div');
                    successMessage.className = 'source-success';
                    successMessage.textContent = 'Source added successfully!';

                    // Add it to the form
                    form.appendChild(successMessage);

                    // Close modal after a short delay
                    setTimeout(function() {
                        sourceModal.classList.remove('show');
                        // Remove success message when closing
                        form.removeChild(successMessage);
                    }, 1500);
                } else {
                    // Error - display error message within form
                    const form = evt.detail.target;

                    // Check if form already has an error message
                    const existingError = form.querySelector('.source-error');
                    if (existingError) {
                        form.removeChild(existingError);
                    }

                    // Create error message
                    const errorMessage = document.createElement('div');
                    errorMessage.className = 'source-error';
                    errorMessage.textContent = responseText || 'Error adding source. Please try again.';

                    // Add it to the form
                    form.appendChild(errorMessage);
                }
            });
        });
    </script>
    </body>
    </html>
{{ end }}