        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noticia+Text&display=swap" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/fonts/css2?family=Playfair+Display:wght@400;700&display=swap"
              rel="stylesheet">
        <meta name="title" content="Web 6 am">
        <meta name="description" content="Compilamos informacion mas relevante y te la traemos">

        <meta charset="UTF-8">
        <meta name="viewport"
              content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, shrink-to-fit=no">
        <meta http-equiv="X-UA-Compatible" content="ie=edge">

        <meta property="og:title" content="Inforia"/>
        <meta property="og:description" content="La web para mentenerte informado"/>
        <meta property="og:url" content="https://inforia.io"/>
