{{template "base" .}}

{{define "head"}}
    <link rel="stylesheet" href="/static/css/styles.css"/>
    <title>{{.Article.Title}}</title>
{{end}}

{{define "content"}}
    <button onclick="history.back()" class="back-home">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
        </svg>
        Volver
    </button>

    <article class="single-news">
        {{$article := .Article}}
        <h2>{{ $article.Title }}</h2>

        <div class="article-actions">
            <button id="share-button" class="share-button">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                    <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/>
                </svg>
                Compartir
            </button>
        </div>

        <div>{{ $article.Description}}</div>
        <div>{{ $article.Content}}</div>
    </article>

    <!-- Share Modal -->
    <div class="modal" id="share-modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <h3>Compartir Artículo</h3>

            <div class="share-options">
                <a href="#" class="share-option" id="share-facebook">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                        <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/>
                    </svg>
                    <span>Facebook</span>
                </a>

                <a href="#" class="share-option" id="share-twitter">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                        <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/>
                    </svg>
                    <span>Twitter</span>
                </a>

                <a href="#" class="share-option" id="share-whatsapp">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                        <path d="M16.75 13.96c.25.13.41.2.46.3.06.11.04.61-.21 1.18-.2.56-1.24 1.1-1.7 1.12-.46.02-.47.36-2.96-.73-2.49-1.09-3.99-3.75-4.11-3.92-.12-.17-.96-1.38-.92-2.61.05-1.22.69-1.8.95-2.04.24-.26.51-.29.68-.26h.47c.15 0 .36-.06.55.45l.69 1.87c.06.13.1.28.01.44l-.27.41-.39.42c-.12.12-.26.25-.12.5.12.26.62 1.09 1.32 1.78.91.88 1.71 1.17 1.95 1.3.24.14.39.12.54-.04l.81-.94c.19-.25.35-.19.58-.11l1.67.88M12 2a10 10 0 0 1 10 10 10 10 0 0 1-10 10c-1.97 0-3.8-.57-5.35-1.55L2 22l1.55-4.65A9.969 9.969 0 0 1 2 12 10 10 0 0 1 12 2m0 2a8 8 0 0 0-8 8c0 1.72.54 3.31 1.46 4.61L4.5 19.5l2.89-.96A7.95 7.95 0 0 0 12 20a8 8 0 0 0 8-8 8 8 0 0 0-8-8z"/>
                    </svg>
                    <span>WhatsApp</span>
                </a>

                <button class="share-option" id="copy-link">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                        <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
                    </svg>
                    <span>Copiar Enlace</span>
                </button>
            </div>

            <div id="copy-success" class="success-message" style="display: none;">
                Enlace copiado al portapapeles
            </div>
        </div>
    </div>

{{end}}

{{define "js"}}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Share button
            const shareButton = document.getElementById('share-button');
            const shareModal = document.getElementById('share-modal');
            const closeShareModal = shareModal.querySelector('.close-modal');
            const copyLinkButton = document.getElementById('copy-link');
            const copySuccess = document.getElementById('copy-success');

            // Show share modal
            shareButton.addEventListener('click', function() {
                shareModal.classList.add('show');
            });

            // Close share modal
            closeShareModal.addEventListener('click', function() {
                shareModal.classList.remove('show');
            });

            // Close modal when clicking outside
            window.addEventListener('click', function(event) {
                if (event.target === shareModal) {
                    shareModal.classList.remove('show');
                }
            });

            // Share via Facebook
            document.getElementById('share-facebook').addEventListener('click', function(e) {
                e.preventDefault();
                window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(window.location.href)}`, 'facebook-share', 'width=580, height=296');
            });

            // Share via Twitter
            document.getElementById('share-twitter').addEventListener('click', function(e) {
                e.preventDefault();
                const text = document.querySelector('h2').textContent.trim();
                window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(window.location.href)}`, 'twitter-share', 'width=580, height=296');
            });

            // Share via WhatsApp
            document.getElementById('share-whatsapp').addEventListener('click', function(e) {
                e.preventDefault();
                const text = document.querySelector('h2').textContent.trim();
                const url = window.location.href;
                window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text + ' ' + url)}`, '_blank');
            });

            // Copy link to clipboard
            copyLinkButton.addEventListener('click', function() {
                navigator.clipboard.writeText(window.location.href).then(function() {
                    copySuccess.style.display = 'block';
                    setTimeout(function() {
                        copySuccess.style.display = 'none';
                    }, 2000);
                }).catch(function(err) {
                    console.error('Could not copy text: ', err);
                });
            });
        });
    </script>
{{end}}